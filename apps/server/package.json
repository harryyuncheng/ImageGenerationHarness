{
  "name": "@harness/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.850.0",
    "@fastify/helmet": "^13.0.1",
    "@harness/capabilities": "workspace:*",
    "@harness/contracts": "workspace:*",
    "@harness/domain": "workspace:*",
    "@harness/image": "workspace:*",
    "fastify": "^5.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
