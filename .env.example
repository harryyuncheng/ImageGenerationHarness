# Azure AI Foundry provider (optional).
#
# Copy this file to `.env` in the repository root and fill in your values.
# The server loads it at startup; `.env` is gitignored and only this example is tracked.
# A variable already set in the shell takes precedence over the value here.
#
# Leave the file absent to run the harness with Amazon Bedrock only.

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Optional. Defaults to the api-version pinned by the server.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional. Defaults to the deployment name in the capability registry, `gpt-image-2`.
# AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
